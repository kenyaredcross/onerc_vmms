# Dependency directories
node_modules/
jspm_packages/

# The trailing slash above matches a directory, and `vmmsx/public/node_modules`
# is a symlink to the app's own — which git sees as a file, not a directory, so
# the rule above misses it. Named without one.
node_modules

# Vite build output (generated; regenerate with `bench build --app vmmsx`)
vmmsx/public/portal/

